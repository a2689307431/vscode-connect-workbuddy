{
  "name": "vscode-connect-workbuddy",
  "displayName": "Connect WorkBuddy",
  "description": "把 WorkBuddy 的模型接进 VS Code Copilot Chat 的模型下拉框，支持多账号分组与剩余积分显示（非官方）",
  "version": "0.7.6",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "workbuddy",
        "displayName": "WorkBuddy",
        "configuration": {
          "properties": {
            "workbuddyAccount": {
              "type": "string",
              "title": "WorkBuddy 账号",
              "markdownDescription": "该分组只显示这个账号的模型。填账号 id 或昵称；留空 = 当前账号。扩展会在「WorkBuddy: 管理账号分组」里自动维护这一项。"
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "WorkBuddy for Copilot Chat",
      "properties": {
        "connect-workbuddy.proxyUrl": {
          "type": "string",
          "default": "",
          "description": "留空 = 自动管理（推荐）：复用 8799 上已运行的代理，没有就自己拉起一个随机端口的，VS Code 关闭时自动退出。填了地址则完全使用指定端点，扩展不再插手。"
        },
        "connect-workbuddy.apiKey": {
          "type": "string",
          "default": "workbuddy-local-proxy",
          "description": "占位 API Key（真正的 WorkBuddy token 由代理注入）"
        },
        "connect-workbuddy.debug": {
          "type": "boolean",
          "default": false,
          "description": "在输出面板打印详细日志"
        },
        "connect-workbuddy.nodePath": {
          "type": "string",
          "default": "",
          "description": "运行代理用的 node 可执行文件路径。留空会自动探测常见安装位置和 PATH，都找不到时用 VS Code 自带的 Electron（ELECTRON_RUN_AS_NODE）。"
        },
        "connect-workbuddy.hideLoginPrompt": {
          "type": "boolean",
          "default": false,
          "description": "不再在启动时提示登录（仍然可以用命令面板的「WorkBuddy: 登录账号」）。"
        },
        "connect-workbuddy.showCreditsInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示当前账号的剩余积分（每 5 分钟刷新一次，点一下可看明细）。"
        },
        "connect-workbuddy.creditsRefreshSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 60,
          "description": "状态栏积分的自动刷新间隔（秒），最小 60。上游按账号串行查询，不建议设得太小。"
        },
        "connect-workbuddy.autoCheckin": {
          "type": "boolean",
          "default": false,
          "description": "每天第一次启动 VS Code 时自动签到（默认关闭）。开启后每个账号每天最多签一次；失败会在下次启动重试。"
        }
      }
    },
    "commands": [
      {
        "command": "connect-workbuddy.login",
        "title": "WorkBuddy: 登录账号",
        "category": "WorkBuddy"
      },
      {
        "command": "connect-workbuddy.switchAccount",
        "title": "WorkBuddy: 切换账号",
        "category": "WorkBuddy"
      },
      {
        "command": "connect-workbuddy.showCredits",
        "title": "WorkBuddy: 查看剩余积分",
        "category": "WorkBuddy"
      },
      {
        "command": "connect-workbuddy.checkin",
        "title": "WorkBuddy: 每日签到",
        "category": "WorkBuddy"
      },
      {
        "command": "connect-workbuddy.syncGroups",
        "title": "WorkBuddy: 按账号生成模型分组",
        "category": "WorkBuddy"
      },
      {
        "command": "connect-workbuddy.refresh",
        "title": "WorkBuddy: 刷新模型列表",
        "category": "WorkBuddy"
      },
      {
        "command": "connect-workbuddy.showLogs",
        "title": "WorkBuddy: 显示日志",
        "category": "WorkBuddy"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/a2689307431/vscode-connect-workbuddy.git"
  },
  "bugs": {
    "url": "https://github.com/a2689307431/vscode-connect-workbuddy/issues"
  },
  "homepage": "https://github.com/a2689307431/vscode-connect-workbuddy#readme",
  "keywords": [
    "workbuddy",
    "codebuddy",
    "copilot",
    "chat",
    "llm",
    "openai-compatible"
  ],
  "scripts": {
    "check:upstream": "node scripts/check-upstream.mjs"
  }
}
