# === 不打包的东西 ===

# 开发文档（README 要打，技术文档不进包省体积）
HANDOFF.md
proxy/PROXY.md
.gitignore

# 测试与临时脚本
proxy/tests/**
scripts/**
_test-*.mjs
_rename.mjs

# 手动启动用的 bat（扩展会自动拉起代理，这个只在调试时方便）
proxy/*.bat

# 杂项
*.vsix
*.txt
*.log
*.tgz
*.zip
node_modules

# 打包产物目录（`vsce package --out dist` 的输出位置）
# 里面的 *.vsix 已被上面的规则挡掉，这行是防有人往 dist 里放别的文件
dist/
dist/**
.vscode
.git
# CI 配置与 GitHub 元数据不进包
.github
.github/**
.gitignore
.editorconfig

# ⚠️ 下划线开头的临时/备份目录（旧 git 历史含本机路径与账号信息，绝不能进包）
_*
_*/**

# === 必须打包（确认没被上面误伤）===
#   extension.js
#   package.json
#   README.md
#   proxy/workbuddy-proxy.mjs
#   lib/host-heartbeat-*.js   ← 核心依赖，绝不能排除

